# Discord bot credentials (from the Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: set this to a guild ID during development for instant command updates.
# Leave blank/remove it to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=

# Provided automatically by Railway's Postgres plugin — just reference it as-is.
# Locally, point this at your own Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/wco
